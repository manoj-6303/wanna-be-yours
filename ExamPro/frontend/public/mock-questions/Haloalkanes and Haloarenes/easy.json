    "difficulty": "Easy",
    "question": "The number of halobenzenes from the five structures shown in the diagram that can be prepared by Sandmeyer's reaction is: (see diagram)",
    "questionImage": "halo easy/halo_easy_q2.png",
    "options": [
      {
        "id": "A",
        "text": "2",
        "image": ""
      },
